{
  "name": "remind-ai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"python -m uvicorn backend.main:app --host 127.0.0.1 --port 8000\" \"vite\"",
    "dev:frontend": "vite",
    "dev:backend": "python -m uvicorn backend.main:app --host 127.0.0.1 --port 8000",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "cap:build": "vite build && npx cap sync",
    "cap:open:android": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@supabase/supabase-js": "^2.117.3",
    "lucide-react": "^1.55.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.6",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0"
  }
}
